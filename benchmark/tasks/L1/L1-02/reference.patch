+def truncate(text: str, n: int) -> str:
+    """Word-safe truncation with a trailing ellipsis; result fits in n chars."""
+    if len(text) <= n:
+        return text
+    cut = text[: n - 1]
+    if " " in cut and not text[n - 1 : n].isspace():
+        cut = cut.rsplit(" ", 1)[0]
+    return cut.rstrip() + "\u2026"
