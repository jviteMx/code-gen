@@ -0,0 +1,14 @@
+"""Column position normalization: keep card positions packed as 0..n-1."""
+
+from __future__ import annotations
+
+import sqlite3
+
+
+def normalize_column(conn: sqlite3.Connection, column_id: int) -> None:
+    """Re-pack the column's card positions to 0..n-1, preserving order (ties by id)."""
+    rows = conn.execute(
+        "SELECT id FROM cards WHERE column_id = ? ORDER BY position, id", (column_id,)
+    ).fetchall()
+    for idx, row in enumerate(rows):
+        conn.execute("UPDATE cards SET position = ? WHERE id = ?", (idx, row["id"]))
