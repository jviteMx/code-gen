+def list_cards(conn: sqlite3.Connection, column_id: int, sort: str | None = None,
+               priority: str | None = None, overdue: bool | None = None,
+               q: str | None = None) -> list[dict]:
     rows = conn.execute(
         "SELECT * FROM cards WHERE column_id = ? ORDER BY position, id", (column_id,)
     ).fetchall()
     cards = [_row_to_dict(r) for r in rows]
+    if priority is not None:
+        cards = [c for c in cards if c["priority"] == priority]
+    if q is not None:
+        cards = [c for c in cards if q.lower() in c["title"].lower()]
+    if overdue is not None:
+        cards = [c for c in cards if _is_overdue(c) == overdue]
     if sort == "priority":
         cards = sorted_by_priority(cards)
     return cards
 
 
+def _is_overdue(card: dict) -> bool:
+    due = parse_due_date(card.get("due_date"))
+    return bool(due and due < date.today())
+
+
 def sorted_by_priority(cards: list[dict]) -> list[dict]:
     """Order cards most-urgent first (high before medium before low)."""
     return sorted(cards, key=lambda c: c["priority"])
