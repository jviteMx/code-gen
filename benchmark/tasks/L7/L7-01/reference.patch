@@ -0,0 +1,17 @@
+"""Activity table access."""
+
+from __future__ import annotations
+
+import sqlite3
+
+
+def insert_event(conn: sqlite3.Connection, action: str, entity_type: str, entity_id: int) -> None:
+    conn.execute(
+        "INSERT INTO activity (action, entity_type, entity_id) VALUES (?, ?, ?)",
+        (action, entity_type, entity_id),
+    )
+
+
+def fetch_events(conn: sqlite3.Connection, limit: int) -> list[dict]:
+    rows = conn.execute("SELECT * FROM activity ORDER BY id LIMIT ?", (limit,)).fetchall()
+    return [dict(r) for r in rows]
diff --git a/backend/app/repositories/boards.py b/backend/app/repositories/boards.py
new file mode 100644
index 0000000..7678db3
--- /dev/null
+++ b/backend/app/repositories/boards.py
@@ -0,0 +1,59 @@
+"""Boards and columns table access."""
+
+from __future__ import annotations
+
+import sqlite3
+
+
+def fetch_boards(conn: sqlite3.Connection) -> list[dict]:
+    rows = conn.execute("SELECT id, name, slug FROM boards ORDER BY id").fetchall()
+    return [dict(r) for r in rows]
+
+
+def fetch_board(conn: sqlite3.Connection, board_id: int) -> sqlite3.Row | None:
+    return conn.execute("SELECT * FROM boards WHERE id = ?", (board_id,)).fetchone()
+
+
+def slug_exists(conn: sqlite3.Connection, slug: str) -> bool:
+    return conn.execute("SELECT 1 FROM boards WHERE slug = ?", (slug,)).fetchone() is not None
+
+
+def insert_board(conn: sqlite3.Connection, name: str, slug: str) -> int:
+    return conn.execute("INSERT INTO boards (name, slug) VALUES (?, ?)", (name, slug)).lastrowid
+
+
+def fetch_columns(conn: sqlite3.Connection, board_id: int) -> list[sqlite3.Row]:
+    return conn.execute(
+        "SELECT * FROM columns WHERE board_id = ? ORDER BY position, id", (board_id,)
+    ).fetchall()
+
+
+def fetch_column(conn: sqlite3.Connection, column_id: int) -> sqlite3.Row | None:
+    return conn.execute("SELECT * FROM columns WHERE id = ?", (column_id,)).fetchone()
+
+
+def next_column_position(conn: sqlite3.Connection, board_id: int) -> int:
+    return conn.execute(
+        "SELECT COALESCE(MAX(position) + 1, 0) FROM columns WHERE board_id = ?", (board_id,)
+    ).fetchone()[0]
+
+
+def insert_column(conn: sqlite3.Connection, board_id: int, name: str, position: int,
+                  wip_limit: int | None) -> int:
+    cur = conn.execute(
+        "INSERT INTO columns (board_id, name, position, wip_limit) VALUES (?, ?, ?, ?)",
+        (board_id, name, position, wip_limit),
+    )
+    return cur.lastrowid
+
+
+def update_column(conn: sqlite3.Connection, column_id: int, name: str,
+                  wip_limit: int | None) -> None:
+    conn.execute(
+        "UPDATE columns SET name = ?, wip_limit = ? WHERE id = ?",
+        (name, wip_limit, column_id),
+    )
+
+
+def delete_column(conn: sqlite3.Connection, column_id: int) -> None:
+    conn.execute("DELETE FROM columns WHERE id = ?", (column_id,))
diff --git a/backend/app/repositories/cards.py b/backend/app/repositories/cards.py
new file mode 100644
index 0000000..01b7d7e
--- /dev/null
+++ b/backend/app/repositories/cards.py
@@ -0,0 +1,47 @@
+"""Cards table access."""
+
+from __future__ import annotations
+
+import sqlite3
+
+
+def fetch_card(conn: sqlite3.Connection, card_id: int) -> sqlite3.Row | None:
+    return conn.execute("SELECT * FROM cards WHERE id = ?", (card_id,)).fetchone()
+
+
+def fetch_cards(conn: sqlite3.Connection, column_id: int) -> list[sqlite3.Row]:
+    return conn.execute(
+        "SELECT * FROM cards WHERE column_id = ? ORDER BY position, id", (column_id,)
+    ).fetchall()
+
+
+def next_position(conn: sqlite3.Connection, column_id: int) -> int:
+    return conn.execute(
+        "SELECT COALESCE(MAX(position) + 1, 0) FROM cards WHERE column_id = ?", (column_id,)
+    ).fetchone()[0]
+
+
+def insert_card(conn: sqlite3.Connection, column_id: int, title: str, description: str,
+                priority: str, due_date: str | None, position: int) -> int:
+    cur = conn.execute(
+        "INSERT INTO cards (column_id, title, description, priority, due_date, position) "
+        "VALUES (?, ?, ?, ?, ?, ?)",
+        (column_id, title, description, priority, due_date, position),
+    )
+    return cur.lastrowid
+
+
+def update_fields(conn: sqlite3.Connection, card_id: int, fields: dict) -> None:
+    sets = ", ".join(f"{k} = ?" for k in fields)
+    conn.execute(f"UPDATE cards SET {sets} WHERE id = ?", (*fields.values(), card_id))
+
+
+def delete_card(conn: sqlite3.Connection, card_id: int) -> None:
+    conn.execute("DELETE FROM cards WHERE id = ?", (card_id,))
+
+
+def set_location(conn: sqlite3.Connection, card_id: int, column_id: int, position: int) -> None:
+    conn.execute(
+        "UPDATE cards SET column_id = ?, position = ? WHERE id = ?",
+        (column_id, position, card_id),
+    )
