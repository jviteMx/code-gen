diff --git a/frontend/src/components/RecentlyDeleted.jsx b/frontend/src/components/RecentlyDeleted.jsx
new file mode 100644
index 0000000..7783510
--- /dev/null
+++ b/frontend/src/components/RecentlyDeleted.jsx
@@ -0,0 +1,24 @@
+import { restoreCard } from '../api.js'
+
+export default function RecentlyDeleted({ cards, onChange }) {
+  async function restore(id) {
+    await restoreCard(id)
+    onChange()
+  }
+
+  return (
+    <aside className="recently-deleted">
+      <h3 className="recently-deleted-title">Recently deleted</h3>
+      <ul className="recently-deleted-list">
+        {cards.map((card) => (
+          <li key={card.id} className="recently-deleted-item">
+            <span className="deleted-card-title">{card.title}</span>
+            <button type="button" className="restore-btn" onClick={() => restore(card.id)}>
+              Restore
+            </button>
+          </li>
+        ))}
+      </ul>
+    </aside>
+  )
+}
