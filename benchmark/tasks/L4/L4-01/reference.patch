+def _check_wip(conn: sqlite3.Connection, column_id: int) -> None:
+    """409 if the column is at its wip_limit (NULL means unlimited)."""
+    row = conn.execute("SELECT wip_limit FROM columns WHERE id = ?", (column_id,)).fetchone()
+    limit = row["wip_limit"] if row else None
+    if limit is None:
+        return
+    count = conn.execute(
+        "SELECT COUNT(*) FROM cards WHERE column_id = ?", (column_id,)
+    ).fetchone()[0]
+    if count >= limit:
+        ActivityLog(conn).record("wip_rejected", "column", column_id)
+        # the request-scoped dependency won't commit on a failed request
+        conn.commit()
+        raise HTTPException(status_code=409, detail={
+            "error": "wip_limit_exceeded", "column_id": column_id, "wip_limit": limit,
+        })
+
